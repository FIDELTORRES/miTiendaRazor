@page
@model miTienda.Pages.Auth.ForgotPasswordModel
@{
    // Título de la página que se muestra en el navegador
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_Layout"; // Usa el layout principal
}

<!-- Contenedor principal con fondo oscuro y altura completa -->
<div class="container py-5" style="background-color: #070B12; min-height: 100vh; color: #FAFAFA;">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <!-- Tarjeta del formulario -->
            <div class="card" style="background-color: #1A1F2E; border: none; border-radius: 12px; padding: 32px;">
                <!-- Título -->
                <h3 style="color: #FFA600; font-weight: bold; text-align: center;">🔑 Recuperar Contraseña</h3>
                <!-- Subtítulo -->
                <p style="color: #a0a0a0; text-align: center; font-size: 14px;">
                    Te enviaremos un enlace para restablecer tu contraseña
                </p>
                <hr style="border-color: #0B6299;" />

                <!-- Mensaje de error (si existe) -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" style="background-color: #3d1a1a; border-color: #ff4444; color: #ff8888;">
                        ❌ @Model.ErrorMessage
                    </div>
                }

                <!-- Mensaje de éxito (si existe) -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success" style="background-color: #1a3d1a; border-color: #44ff44; color: #88ff88;">
                        ✅ @Model.SuccessMessage
                    </div>
                }

                <!-- Formulario -->
                <form method="post">
                    <!-- Token antifalsificación (CSRF) -->
                    @Html.AntiForgeryToken()

                    <!-- Campo: Correo Electrónico -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="color: #FAFAFA; font-weight: bold;">
                            Correo Electrónico
                        </label>
                        <!-- Input con estilos personalizados -->
                        <input asp-for="Email" type="email" class="form-control" 
                               style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                               placeholder="ejemplo@correo.com" required />
                        <!-- Validación del lado del cliente -->
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Botón Enviar -->
                    <button type="submit" class="btn w-100" style="background-color: #FFA600; color: #070B12; font-weight: bold; border-radius: 8px; padding: 12px; font-size: 16px; transition: all 0.3s ease;"
                            onmouseover="this.style.backgroundColor='#e69500';" 
                            onmouseout="this.style.backgroundColor='#FFA600';">
                        📩 Enviar enlace
                    </button>
                </form>

                <!-- Enlace para volver al login -->
                <div class="text-center mt-3">
                    <p style="color: #8c8c8c; font-size: 14px;">
                        <a asp-page="/Auth/Login" style="color: #FFA600; text-decoration: none; font-weight: bold;">
                            ← Volver a Iniciar Sesión
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts de validación -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}