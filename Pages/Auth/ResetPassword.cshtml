@page
@model miTienda.Pages.Auth.ResetPasswordModel
@{
    // Título de la página
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_Layout";
}

<!-- Contenedor principal -->
<div class="container py-5" style="background-color: #070B12; min-height: 100vh; color: #FAFAFA;">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <!-- Tarjeta del formulario -->
            <div class="card" style="background-color: #1A1F2E; border: none; border-radius: 12px; padding: 32px;">
                <!-- Título -->
                <h3 style="color: #FFA600; font-weight: bold; text-align: center;">🔑 Nueva Contraseña</h3>
                <!-- Subtítulo -->
                <p style="color: #a0a0a0; text-align: center; font-size: 14px;">
                    Ingresa tu nueva contraseña
                </p>
                <hr style="border-color: #0B6299;" />

                <!-- Mensaje de error -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" style="background-color: #3d1a1a; border-color: #ff4444; color: #ff8888;">
                        ❌ @Model.ErrorMessage
                    </div>
                }

                <!-- Mensaje de éxito -->
                @if (Model.Success)
                {
                    <div class="alert alert-success" style="background-color: #1a3d1a; border-color: #44ff44; color: #88ff88;">
                        ✅ ¡Contraseña restablecida exitosamente!
                    </div>
                    <div class="text-center mt-3">
                        <a asp-page="/Auth/Login" class="btn" style="background-color: #FFA600; color: #070B12; font-weight: bold; border-radius: 8px; padding: 10px 30px;">
                            🔐 Iniciar Sesión
                        </a>
                    </div>
                }
                else
                {
                    <!-- Formulario (solo si no hay éxito) -->
                    <form method="post">
                        <!-- Token antifalsificación -->
                        @Html.AntiForgeryToken()

                        <!-- Campos ocultos: Email y Token (vienen de la URL) -->
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <!-- Campo: Nueva Contraseña -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label" style="color: #FAFAFA; font-weight: bold;">
                                Nueva Contraseña
                            </label>
                            <input asp-for="NewPassword" type="password" class="form-control" 
                                   style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                                   placeholder="Mínimo 6 caracteres" required />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <small class="text-muted" style="color: #8c8c8c; font-size: 12px;">
                                Mínimo 6 caracteres, incluyendo mayúsculas, minúsculas y números
                            </small>
                        </div>

                        <!-- Campo: Confirmar Contraseña -->
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label" style="color: #FAFAFA; font-weight: bold;">
                                Confirmar Contraseña
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" 
                                   style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                                   placeholder="Repite tu nueva contraseña" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Botón Restablecer -->
                        <button type="submit" class="btn w-100" style="background-color: #FFA600; color: #070B12; font-weight: bold; border-radius: 8px; padding: 12px; font-size: 16px; transition: all 0.3s ease;"
                                onmouseover="this.style.backgroundColor='#e69500';" 
                                onmouseout="this.style.backgroundColor='#FFA600';">
                            🔒 Restablecer Contraseña
                        </button>
                    </form>

                    <!-- Enlace para volver al login -->
                    <div class="text-center mt-3">
                        <p style="color: #8c8c8c; font-size: 14px;">
                            <a asp-page="/Auth/Login" style="color: #FFA600; text-decoration: none; font-weight: bold;">
                                ← Volver a Iniciar Sesión
                            </a>
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Scripts de validación -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}