@page
@model miTienda.Pages.EditarProductoModel
@{
    ViewData["Title"] = "✏️ Editar Producto";
}

<h2>✏️ Editar Producto</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Vista previa de la imagen -->
    <div class="col-md-3">
        <div class="card">
            <div class="card-header bg-info text-white">
                <strong>🖼️ Vista Previa</strong>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Producto.Imagen))
                {
                    <img src="~/images/productos/@Model.Producto.Imagen" 
                         alt="@Model.Producto.Nombre" 
                         class="img-fluid rounded" 
                         style="max-height: 200px; object-fit: contain;" 
                         id="previewImagen" />
                }
                else
                {
                    <div class="alert alert-secondary">
                        <span class="display-4">📷</span>
                        <p class="mt-2">Sin imagen</p>
                    </div>
                }
                <small class="text-muted d-block mt-2">
                    Sube la imagen a: <code>wwwroot/images/productos/</code>
                </small>
            </div>
        </div>
    </div>

    <!-- Formulario -->
    <div class="col-md-9">
        <form method="post">
            <input type="hidden" asp-for="ProductoTienda.Id" />
            <input type="hidden" asp-for="ProductoTienda.IdProducto" />
            <input type="hidden" asp-for="Producto.IdProducto" />

            <div class="row">
                <!-- Columna Izquierda: Datos del Producto -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <strong>📋 Datos del Producto</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="Producto.Nombre" class="form-label fw-bold"></label>
                                <input asp-for="Producto.Nombre" class="form-control" />
                                <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Producto.Codigo" class="form-label fw-bold">Código</label>
                                <input asp-for="Producto.Codigo" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Producto.Descripcion" class="form-label fw-bold">Descripción</label>
                                <textarea asp-for="Producto.Descripcion" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Producto.Imagen" class="form-label fw-bold">Nombre de Imagen</label>
                                <input asp-for="Producto.Imagen" class="form-control" 
                                       placeholder="ej: producto123.jpg" 
                                       oninput="actualizarPreview(this.value)" />
                                <small class="text-muted">Archivo debe estar en: <code>wwwroot/images/productos/</code></small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Producto.Estado" class="form-label fw-bold">Estado Producto</label>
                                <select asp-for="Producto.Estado" class="form-select">
                                    <option value="1">✅ Activo</option>
                                    <option value="0">❌ Inactivo</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Datos de Tienda -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <strong>🏪 Datos de Tienda</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="ProductoTienda.IdTienda" class="form-label fw-bold">Tienda</label>
                                <select asp-for="ProductoTienda.IdTienda" class="form-select">
                                    <option value="2">🏪 Tienda 2 (Principal)</option>
                                    <option value="3">📦 Almacén 3</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ProductoTienda.Codbarra" class="form-label fw-bold">Código de Barras</label>
                                <input asp-for="ProductoTienda.Codbarra" class="form-control" />
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProductoTienda.Stock" class="form-label fw-bold">Stock</label>
                                        <input asp-for="ProductoTienda.Stock" class="form-control" type="number" step="0.01" />
                                        <span asp-validation-for="ProductoTienda.Stock" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProductoTienda.Estado" class="form-label fw-bold">Estado</label>
                                        <select asp-for="ProductoTienda.Estado" class="form-select">
                                            <option value="1">✅ Activo</option>
                                            <option value="0">❌ Inactivo</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProductoTienda.PrecioVenta" class="form-label fw-bold">Precio Venta</label>
                                        <div class="input-group">
                                            <span class="input-group-text">S/</span>
                                            <input asp-for="ProductoTienda.PrecioVenta" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <span asp-validation-for="ProductoTienda.PrecioVenta" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProductoTienda.PrecioCompra" class="form-label fw-bold">Precio Compra</label>
                                        <div class="input-group">
                                            <span class="input-group-text">S/</span>
                                            <input asp-for="ProductoTienda.PrecioCompra" class="form-control" type="number" step="0.01" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Última Modificación</label>
                                <div class="text-muted">
                                    Fecha: @(Model.ProductoTienda.FechaModifica?.ToString("dd/MM/yyyy") ?? "Nunca") - 
                                    Hora: @(Model.ProductoTienda.HoraModifica?.ToString() ?? "Nunca")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="mt-4 text-center">
                <button type="submit" class="btn btn-primary btn-lg">
                    💾 Guardar Cambios
                </button>
                <a asp-page="/Productos" class="btn btn-secondary btn-lg">
                    ⬅️ Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Función para actualizar la vista previa de la imagen
        function actualizarPreview(nombreImagen) {
            if (nombreImagen) {
                const preview = document.getElementById('previewImagen');
                if (preview) {
                    preview.src = '/images/productos/' + nombreImagen;
                    preview.onerror = function() {
                        this.src = ''; // Si la imagen no existe, mostrar el placeholder
                        this.alt = 'Imagen no encontrada';
                    };
                }
            }
        }
    </script>
}