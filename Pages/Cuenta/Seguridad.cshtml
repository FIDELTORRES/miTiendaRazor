@page
@model miTienda.Pages.Cuenta.SeguridadModel
@{
    ViewData["Title"] = "Seguridad";
    Layout = "_Layout";
}

<div class="container py-5" style="background-color: #070B12; min-height: 100vh; color: #FAFAFA;">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h2 style="color: #FAFAFA; font-weight: bold;">🔐 Seguridad</h2>
            <p style="color: #a0a0a0;">Cambia tu contraseña para mantener tu cuenta segura.</p>
            <hr style="border-color: #0B6299;" />

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert" style="background-color: #1a3d1a; border-color: #44ff44; color: #88ff88;">
                    ✅ @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert" style="background-color: #3d1a1a; border-color: #ff4444; color: #ff8888;">
                    ❌ @Model.ErrorMessage
                </div>
            }

            <div class="card" style="background-color: #1A1F2E; border: none; border-radius: 12px; padding: 32px;">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" style="color: #FAFAFA; font-weight: bold;">Contraseña Actual</label>
                        <input type="password" asp-for="CambiarPassword.PasswordActual" class="form-control"
                               style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                               placeholder="Tu contraseña actual" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #FAFAFA; font-weight: bold;">Nueva Contraseña</label>
                        <input type="password" asp-for="CambiarPassword.NuevaPassword" class="form-control"
                               style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                               placeholder="Mínimo 6 caracteres" required />
                        <small style="color: #8c8c8c;">Mínimo 6 caracteres, incluyendo mayúsculas, minúsculas y números.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #FAFAFA; font-weight: bold;">Confirmar Nueva Contraseña</label>
                        <input type="password" asp-for="CambiarPassword.ConfirmarPassword" class="form-control"
                               style="background-color: #070B12; color: #FAFAFA; border-color: #0B6299; border-radius: 8px; padding: 12px;"
                               placeholder="Repite la nueva contraseña" required />
                    </div>

                    <button type="submit" class="btn w-100 mt-3" style="background-color: #FFA600; color: #070B12; font-weight: bold; border-radius: 8px; padding: 12px; font-size: 16px;">
                        🔐 Cambiar Contraseña
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>