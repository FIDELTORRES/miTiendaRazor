@page "{id:int}"
@model miTienda.Pages.Cuenta.DetallePedidoModel
@{
    ViewData["Title"] = $"Pedido #{Model.Pedido?.IdPedidoWeb}";
    Layout = "_Layout";
}

<div class="container py-5" style="background-color: #070B12; min-height: 100vh; color: #FAFAFA;">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Botón volver -->
            <a asp-page="/Cuenta/Pedidos" class="btn mb-3" style="background-color: #0B6299; color: #FAFAFA; border-radius: 8px; padding: 8px 20px; font-weight: bold; border: 1px solid #FFA600;">
                ← Volver a Mis Pedidos
            </a>

            @if (Model.Pedido != null)
            {
                <!-- Cabecera -->
                <div class="card mb-4" style="background-color: #1A1F2E; border: 1px solid #0B6299; border-radius: 12px; padding: 20px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 style="color: #FFA600; font-weight: bold; margin: 0;">Pedido #@Model.Pedido.IdPedidoWeb</h3>
                            <p style="color: #a0a0a0; margin: 4px 0 0 0; font-size: 14px;">
                                Realizado el @Model.Pedido.Fecha?.ToString("dd/MM/yyyy") a las @Model.Pedido.Hora?.ToString("HH:mm")
                            </p>
                        </div>
                        <div>
                            @if (Model.Pedido.EstadoPedido == 1)
                            {
                                <span class="badge" style="background-color: #FFA600; color: #070B12; padding: 8px 16px; font-size: 14px;">⏳ Pendiente</span>
                            }
                            else if (Model.Pedido.EstadoPedido == 2)
                            {
                                <span class="badge" style="background-color: #0B6299; color: #FAFAFA; padding: 8px 16px; font-size: 14px;">✅ Procesado</span>
                            }
                            else if (Model.Pedido.EstadoPedido == 3)
                            {
                                <span class="badge" style="background-color: #28a745; color: white; padding: 8px 16px; font-size: 14px;">🚚 Enviado</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Información de envío -->
                <div class="card mb-4" style="background-color: #1A1F2E; border: 1px solid #0B6299; border-radius: 12px; padding: 20px;">
                    <h5 style="color: #FFA600; font-weight: bold;">📍 Información de Envío</h5>
                    <hr style="border-color: #0B6299;" />
                    <div class="row">
                        <div class="col-md-6">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Dirección:</strong><br />
                                @Model.Pedido.DireccionEntrega
                            </p>
                        </div>
                        <div class="col-md-3">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Fecha de entrega:</strong><br />
                                @Model.Pedido.FechaEntrega?.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <div class="col-md-3">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Hora de entrega:</strong><br />
                                @Model.Pedido.HoraEntrega?.ToString("HH:mm")
                            </p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Pedido.Indicaciones))
                    {
                        <div class="mt-3">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Indicaciones:</strong> @Model.Pedido.Indicaciones
                            </p>
                        </div>
                    }
                </div>

                <!-- Información de pago -->
                <div class="card mb-4" style="background-color: #1A1F2E; border: 1px solid #0B6299; border-radius: 12px; padding: 20px;">
                    <h5 style="color: #FFA600; font-weight: bold;">💳 Información de Pago</h5>
                    <hr style="border-color: #0B6299;" />
                    <div class="row">
                        <div class="col-md-6">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Método de pago:</strong><br />
                                @(Model.Pedido.MedioPago == 1 ? "Yape" : Model.Pedido.MedioPago == 2 ? "Plin" : Model.Pedido.MedioPago == 3 ? "Transferencia" : "Otro")
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p style="color: #a0a0a0; margin: 0; font-size: 14px;">
                                <strong style="color: #FAFAFA;">Código de transacción:</strong><br />
                                @(Model.Pedido.IdTransaccion ?? "-")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Detalle de productos -->
                <div class="card mb-4" style="background-color: #1A1F2E; border: 1px solid #0B6299; border-radius: 12px; padding: 20px;">
                    <h5 style="color: #FFA600; font-weight: bold;">🛒 Productos</h5>
                    <hr style="border-color: #0B6299;" />

                    <div class="table-responsive">
                        <table class="table" style="color: #FAFAFA;">
                            <thead>
                                <tr style="border-bottom: 2px solid #FFA600;">
                                    <th style="color: #FFA600;">Imagen</th>
                                    <th style="color: #FFA600;">Producto</th>
                                    <th style="color: #FFA600; text-align: center;">Cantidad</th>
                                    <th style="color: #FFA600; text-align: right;">Precio</th>
                                    <th style="color: #FFA600; text-align: right;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in Model.Detalles)
                                {
                                    <tr style="border-bottom: 1px solid #0B6299;">
                                        <td style="width: 70px;">
                                            @if (!string.IsNullOrEmpty(detalle.DirImagen))
                                            {
                                                <img src="~/images/productos/@detalle.DirImagen" 
                                                     alt="@detalle.Descripcion" 
                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; background-color: #070B12; padding: 2px;"
                                                     onerror='this.style.display="none"; this.parentElement.innerHTML="<span style=\"font-size:24px;\">📦</span>";' />
                                            }
                                            else
                                            {
                                                <span style="font-size:24px;">📦</span>
                                            }
                                        </td>
                                        <td>@detalle.Descripcion</td>
                                        <td style="text-align: center;">@detalle.Cantidad</td>
                                        <td style="text-align: right;">S/ @detalle.PrecioVenta?.ToString("F2")</td>
                                        <td style="text-align: right; color: #FFA600; font-weight: bold;">S/ @detalle.ImporteTotal?.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" style="text-align: right; font-size: 18px; font-weight: bold; padding-top: 16px;">Total:</td>
                                    <td style="text-align: right; font-size: 22px; font-weight: bold; color: #FFA600; padding-top: 16px;">
                                        S/ @Model.Pedido.TotalVenta?.ToString("F2")
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="text-align: right; font-size: 12px; color: #888;">IGV incluido en el total</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div style="font-size: 80px; margin-bottom: 20px;">❌</div>
                    <p style="color: #a0a0a0; font-size: 18px;">Pedido no encontrado.</p>
                    <a asp-page="/Cuenta/Pedidos" class="btn mt-3" style="background-color: #FFA600; color: #070B12; font-weight: bold; border-radius: 8px; padding: 10px 30px;">
                        ← Volver a Mis Pedidos
                    </a>
                </div>
            }
        </div>
    </div>
</div>