@page
@model miTienda.Pages.Admin.Categorias.Subcategoriapagina.IndexModel
@{
    ViewData["Title"] = "Subcategorías Página";
    Layout = "_LayoutAdmin";
}

<!-- 
    ============================================================
    📌 ENCABEZADO Y BOTÓN NUEVO (responsive)
    ============================================================
-->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="mb-2 mb-md-0">📂 Subcategorías Página (Nivel 3)</h2>
    <a asp-page="./Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nueva Subcategoría
    </a>
</div>

<hr />

<!-- ============================================================ -->
<!-- 📌 MENSAJES DE ÉXITO/ERROR                                   -->
<!-- ============================================================ -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ============================================================ -->
<!-- 📌 FILTROS                                                   -->
<!-- ============================================================ -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <strong><i class="bi bi-search me-1"></i> Buscar Subcategorías</strong>
    </div>
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <!-- Filtro por Descripción -->
                <div class="col-md-4">
                    <label class="form-label">Descripción</label>
                    <input type="text" name="descripcionFiltro" class="form-control"
                           placeholder="Buscar por descripción..."
                           value="@Model.DescripcionFiltro" />
                </div>

                <!-- Filtro por Estado -->
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estadoFiltro" class="form-select">
                        <option value="">Todos</option>
                        <option value="1" selected="@(Model.EstadoFiltro == 1)">Activo</option>
                        <option value="0" selected="@(Model.EstadoFiltro == 0)">Inactivo</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-md-5 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                    <a asp-page="./Index" asp-route-handler="LimpiarFiltros" class="btn btn-secondary">
                        <i class="bi bi-eraser me-1"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- 📌 TABLA RESPONSIVE CON CARDS EN MÓVIL                       -->
<!-- ============================================================ -->

<!-- 
    🔥 EN MÓVIL (menos de 768px): Mostrar como cards
    🔥 EN TABLET Y DESKTOP (más de 768px): Mostrar como tabla
-->
<div class="table-responsive d-none d-md-block">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th>Categoría Página</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Subcategorias.Any())
            {
                @foreach (var item in Model.Subcategorias)
                {
                    <tr>
                        <td>@item.IdSubcategoriapagina</td>
                        <td>@item.Descripcion</td>
                        <td>@(item.CategoriaPaginaDesc ?? "Sin categoría")</td>
                        <td>
                            @if (item.Estado == 1)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <!-- Botón Editar -->
                            <a asp-page="./Editar" asp-route-id="@item.IdSubcategoriapagina" 
                               class="btn btn-sm btn-primary" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>

                            <!-- Botón Cambiar Estado -->
                            @if (item.Estado == 1)
                            {
                                <button type="button" class="btn btn-sm btn-danger" 
                                        onclick="cambiarEstado(@item.IdSubcategoriapagina, 0, '@item.Descripcion')" title="Desactivar">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-success" 
                                        onclick="cambiarEstado(@item.IdSubcategoriapagina, 1, '@item.Descripcion')" title="Activar">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">
                        <i class="bi bi-inbox me-1"></i> No hay subcategorías página registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- 
    🔥 VISTA EN MÓVIL: Cards en lugar de tabla
-->
<div class="d-md-none">
    @if (Model.Subcategorias.Any())
    {
        <div class="row g-3">
            @foreach (var item in Model.Subcategorias)
            {
                <div class="col-12 col-sm-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <!-- ID y Estado -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">
                                    <i class="bi bi-hash me-1"></i>@item.IdSubcategoriapagina
                                </span>
                                @if (item.Estado == 1)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                                }
                            </div>

                            <!-- Descripción -->
                            <h6 class="card-title text-light mb-2">@item.Descripcion</h6>

                            <!-- Categoría Página -->
                            <div class="mb-2">
                                <small class="text-muted">Categoría Página:</small>
                                <span class="text-light" style="font-size: 14px;">
                                    @(item.CategoriaPaginaDesc ?? "Sin categoría")
                                </span>
                            </div>

                            <!-- Botones -->
                            <div class="d-flex gap-2 mt-2">
                                <a asp-page="./Editar" asp-route-id="@item.IdSubcategoriapagina" 
                                   class="btn btn-primary btn-sm flex-grow-1">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </a>
                                @if (item.Estado == 1)
                                {
                                    <button type="button" class="btn btn-danger btn-sm" 
                                            onclick="cambiarEstado(@item.IdSubcategoriapagina, 0, '@item.Descripcion')">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success btn-sm" 
                                            onclick="cambiarEstado(@item.IdSubcategoriapagina, 1, '@item.Descripcion')">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-inbox" style="font-size: 48px; display: block; margin-bottom: 10px;"></i>
            No hay subcategorías página registradas
        </div>
    }
</div>

<!-- ============================================================ -->
<!-- 📌 PAGINACIÓN RESPONSIVE                                      -->
<!-- ============================================================ -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <!-- Botón Anterior -->
            @if (Model.PaginaActual > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" 
                       asp-route-pagina="@(Model.PaginaActual - 1)"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">
                        <i class="bi bi-chevron-left me-1"></i> Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link"><i class="bi bi-chevron-left me-1"></i> Anterior</span>
                </li>
            }

            @{
                int inicio = Math.Max(1, Model.PaginaActual - 2);
                int fin = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);

                if (fin - inicio < 4)
                {
                    if (inicio == 1)
                        fin = Math.Min(5, Model.TotalPaginas);
                    else if (fin == Model.TotalPaginas)
                        inicio = Math.Max(1, Model.TotalPaginas - 4);
                }
            }

            @if (inicio > 1)
            {
                <li class="page-item d-none d-sm-block">
                    <a class="page-link" asp-page="./Index" 
                       asp-route-pagina="1"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">1</a>
                </li>
                @if (inicio > 2)
                {
                    <li class="page-item disabled d-none d-sm-block">
                        <span class="page-link">…</span>
                    </li>
                }
            }

            @for (int i = inicio; i <= fin; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="./Index" 
                       asp-route-pagina="@i"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">@i</a>
                </li>
            }

            @if (fin < Model.TotalPaginas)
            {
                @if (fin < Model.TotalPaginas - 1)
                {
                    <li class="page-item disabled d-none d-sm-block">
                        <span class="page-link">…</span>
                    </li>
                }
                <li class="page-item d-none d-sm-block">
                    <a class="page-link" asp-page="./Index" 
                       asp-route-pagina="@Model.TotalPaginas"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">@Model.TotalPaginas</a>
                </li>
            }

            <!-- Botón Siguiente -->
            @if (Model.PaginaActual < Model.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" 
                       asp-route-pagina="@(Model.PaginaActual + 1)"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">
                        Siguiente <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente <i class="bi bi-chevron-right ms-1"></i></span>
                </li>
            }
        </ul>
    </nav>

    <div class="text-center text-muted mt-2">
        <small>
            <i class="bi bi-database me-1"></i>
            Mostrando <strong>@Model.Subcategorias.Count</strong> de <strong>@Model.TotalRegistros</strong> registros
            (Página @Model.PaginaActual de @Model.TotalPaginas)
        </small>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/categoriapagina.css" />
    <script>
        /**
         * ============================================================
         * CAMBIAR ESTADO DE SUBCATEGORÍA (Activar/Desactivar)
         * ============================================================
         */
        function cambiarEstado(id, estado, nombre) {
            var accion = estado == 1 ? 'ACTIVAR' : 'DESACTIVAR';
            if (confirm(`¿Estás seguro de ${accion} la subcategoría "${nombre}"?`)) {
                // 🔥 Usar la URL relativa correcta
                window.location.href = `?handler=ToggleEstado&id=${id}&estado=${estado}`;
            }
        }
        
    </script>
}