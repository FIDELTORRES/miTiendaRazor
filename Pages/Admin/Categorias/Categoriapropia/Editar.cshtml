@page "{id:int}"
@model miTienda.Pages.Admin.Categorias.Categoriapropia.EditarModel
@{
    ViewData["Title"] = "Editar Categoría Propia";
    Layout = "_LayoutAdmin";
}

<!-- 
    ============================================================
    📌 ENCABEZADO
    ============================================================
-->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="mb-2 mb-md-0">✏️ Editar Categoría Propia (Nivel 1)</h2>
    <a asp-page="./Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

<hr />

<!-- ============================================================ -->
<!-- 📌 MENSAJES DE ÉXITO/ERROR                                   -->
<!-- ============================================================ -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ============================================================ -->
<!-- 📌 FORMULARIO                                                -->
<!-- ============================================================ -->
<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CategoriaPropia.IdCategoriapropia" />

            <!-- ============================================================ -->
            <!-- DESCRIPCIÓN                                                  -->
            <!-- ============================================================ -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="CategoriaPropia.Descripcion" class="form-label fw-bold">
                        Descripción <span class="text-danger">*</span>
                    </label>
                    <input asp-for="CategoriaPropia.Descripcion" class="form-control" />
                    <span asp-validation-for="CategoriaPropia.Descripcion" class="text-danger"></span>
                    <small class="form-text text-muted">Máximo 100 caracteres</small>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- IMAGEN ACTUAL (solo lectura)                                 -->
            <!-- ============================================================ -->
            @if (!string.IsNullOrEmpty(Model.CategoriaPropia.Imagen))
            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Imagen actual</label>
                        <div>
                            <img src="~/images/categorias/@Model.CategoriaPropia.Imagen" 
                                 alt="@Model.CategoriaPropia.Descripcion" 
                                 style="max-width:150px; max-height:150px; border-radius:8px; border:1px solid #2d3348; padding:4px;" />
                        </div>
                        <small class="form-text text-muted">Archivo: @Model.CategoriaPropia.Imagen</small>
                    </div>
                </div>
            }

            <!-- ============================================================ -->
            <!-- NUEVA IMAGEN (opcional)                                      -->
            <!-- ============================================================ -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="ImagenFile" class="form-label fw-bold">
                        Cambiar imagen <span class="text-muted">(opcional)</span>
                    </label>
                    <input asp-for="ImagenFile" class="form-control" type="file" accept="image/*" />
                    <small class="form-text text-muted">
                        <i class="bi bi-info-circle me-1"></i> Formatos: JPG, PNG, WEBP (Máx 2MB)
                    </small>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- ESTADO (Radio Buttons)                                       -->
            <!-- ============================================================ -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Estado</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input type="radio" asp-for="CategoriaPropia.Estado" value="1" 
                                   class="form-check-input" id="estadoActivo" />
                            <label class="form-check-label" for="estadoActivo">
                                <i class="bi bi-check-circle text-success"></i> Activo
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input type="radio" asp-for="CategoriaPropia.Estado" value="0" 
                                   class="form-check-input" id="estadoInactivo" />
                            <label class="form-check-label" for="estadoInactivo">
                                <i class="bi bi-x-circle text-danger"></i> Inactivo
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- BOTONES                                                      -->
            <!-- ============================================================ -->
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Actualizar
                </button>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}