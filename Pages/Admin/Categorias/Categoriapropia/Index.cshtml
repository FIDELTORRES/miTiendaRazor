@page
@model miTienda.Pages.Admin.Categorias.Categoriapropia.IndexModel
@{
    ViewData["Title"] = "Categorías Propias (Nivel 1)";
    Layout = "_LayoutAdmin";
}

<h1>📂 Categorías Propias</h1>

<!-- Mensajes de éxito/error -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================================ -->
<!-- FILTROS                                                       -->
<!-- ============================================================ -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <strong>🔍 Buscar Categorías</strong>
    </div>
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <!-- Filtro por Descripción -->
                <div class="col-md-4">
                    <label class="form-label">Descripción</label>
                    <input type="text" name="descripcionFiltro" class="form-control"
                           placeholder="Buscar por descripción..."
                           value="@Model.DescripcionFiltro" />
                </div>

                <!-- Filtro por Estado -->
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estadoFiltro" class="form-select">
                        <option value="">Todos</option>
                        <option value="1" selected="@(Model.EstadoFiltro == 1)">Activo</option>
                        <option value="0" selected="@(Model.EstadoFiltro == 0)">Inactivo</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-md-5 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">🔍 Buscar</button>
                    <a asp-page="./Index" asp-route-handler="LimpiarFiltros" class="btn btn-secondary">🗑️ Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- TABLA DE CATEGORÍAS                                          -->
<!-- ============================================================ -->
<div class="mb-3">
    <a asp-page="./Crear" class="btn btn-success">
        <i class="fas fa-plus"></i> Nueva Categoría
    </a>
</div>

@if (Model.Categorias.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categorias)
                {
                    <tr>
                        <td>@item.IdCategoriapropia</td>
                        <td>@item.Descripcion</td>
                        <td>
                            @if (item.Estado == 1)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <!-- Botón Editar -->
                            <a asp-page="./Editar" asp-route-id="@item.IdCategoriapropia" class="btn btn-sm btn-primary">
                                ✏️
                            </a>

                            <!-- Botón Activar/Desactivar -->
                            @if (item.Estado == 1)
                            {
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="cambiarEstado(@item.IdCategoriapropia, 0, '@item.Descripcion')">
                                    🗑️
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-success"
                                        onclick="cambiarEstado(@item.IdCategoriapropia, 1, '@item.Descripcion')">
                                    ✅
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ============================================================ -->
    <!-- PAGINACIÓN                                                   -->
    <!-- ============================================================ -->
    <nav aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center">
            @if (Model.PaginaActual > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index"
                       asp-route-pagina="@(Model.PaginaActual - 1)"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">
                        « Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">« Anterior</span></li>
            }

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                if (i == Model.PaginaActual)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index"
                           asp-route-pagina="@i"
                           asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                           asp-route-estadoFiltro="@Model.EstadoFiltro">
                            @i
                        </a>
                    </li>
                }
            }

            @if (Model.PaginaActual < Model.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index"
                       asp-route-pagina="@(Model.PaginaActual + 1)"
                       asp-route-descripcionFiltro="@Model.DescripcionFiltro"
                       asp-route-estadoFiltro="@Model.EstadoFiltro">
                        Siguiente »
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Siguiente »</span></li>
            }
        </ul>
    </nav>

    <div class="text-center text-muted">
        <small>
            Mostrando <strong>@Model.Categorias.Count</strong> registros
            (Página @Model.PaginaActual de @Model.TotalPaginas)
        </small>
    </div>
}
else
{
    <div class="alert alert-warning">
        ⚠️ No se encontraron categorías con los filtros seleccionados.
    </div>
}
 
@section Scripts {
    <link rel="stylesheet" href="~/css/categoriapagina.css" />
    <script>
        function cambiarEstado(id, estado, nombre) {
            var accion = estado == 1 ? 'ACTIVAR' : 'DESACTIVAR';
            if (confirm(`¿Estás seguro de ${accion} la categoría "${nombre}"?`)) {
                // 🔥 CORREGIDO: Usar la URL relativa correcta para Categoriapropia
                window.location.href = `?handler=ToggleEstado&id=${id}&estado=${estado}`;
            }
        }
    </script>
}
